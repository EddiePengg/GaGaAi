# 接入端（ADR-030，openclaw channels 模式）：选 IM 平台，目前可用 feishu；
# 新平台接入见 src/gaga_server/channels/__init__.py 的三步接入法
CHANNEL=feishu

# 飞书接入端（ADR-029/030）：自建应用官方 API 收发（出=im/v1/messages，
# 入=消息轮询），webhook 已弃用。应用需权限 im:message:send_as_bot +
# im:message.group_msg:readonly + im:chat:readonly，机器人已拉入目标群。
# FEISHU_CHAT_ID 留空 = 启动时自动发现（仅当机器人恰好在唯一群里）；
# FEISHU_REPLY_SENDER 指定回复者（ou_ 用户 / cli_ 应用，填 Hermes 的 cli_），
# 留空 = 默认只认任意应用(bot)消息（人的闲聊不点亮设备消息卡）。
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=
# FEISHU_CHAT_ID=oc_xxx
# FEISHU_REPLY_SENDER=cli_xxx
FEISHU_POLL_INTERVAL=2.0

# ASR provider：local_whisper（默认，本地 faster-whisper）/ volcengine（占位未实现，ADR-013）
#              / volc_stream（火山流式直通，帧边到边转发，ADR-022；需 VOLCENGINE_API_KEY，失败自动降级 local_whisper）
ASR_PROVIDER=local_whisper
WHISPER_MODEL=small
WHISPER_LANGUAGE=zh
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# 火山流式 ASR（ASR_PROVIDER=volc_stream 时生效）
# 端点默认单向流式（bigmodel_nostream，ADR-033）；resource 默认 ASR 1.0 小时版。
# ASR 2.0（volc.seedasr.sauc.duration，准确率更高）需在控制台开通后切换。
# VOLC_ASR_ENDPOINT=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_async
# VOLC_ASR_RESOURCE_ID=volc.bigasr.sauc.duration

# 火山引擎占位配置（M1 不接实现，无 Key；接入时填）
# VOLC_APP_ID=
# VOLC_ACCESS_TOKEN=
# VOLC_CLUSTER=volcengine_input_cn

# 实时对话（M5；provider 可插拔 ADR-034/035——选择权在设备：talk_request.provider）
# REALTIME_PROVIDER=volc                    # 设备信令未带 provider 时的默认
# STEP_API_KEY=                             # 阶跃星辰 Step Audio 3 Realtime（ADR-035）
# STEP_MODEL=stepaudio-3-realtime-preview
# STEP_VOICE=linjiajiejie
# API Key 从火山控制台 > API Key 管理获取；不配则 talk_request 回 NOT_IMPLEMENTED
# VOLCENGINE_API_KEY=
REALTIME_ENABLED=true
REALTIME_ENDPOINT=wss://openspeech.bytedance.com/api/v3/duplex/realtime/dialogue
REALTIME_MODEL=1.2.6.1
REALTIME_VOICE=zh_female_vv_uranus_bigtts   # Vivi 2.0；音色列表见火山文档
# REALTIME_INSTRUCTIONS=                    # 系统提示词，默认内置胸前助手人格
REALTIME_IDLE_TIMEOUT=120                   # 空闲超时（秒）
REALTIME_MAX_DURATION=300                   # 单会话最长时长（秒）

# MQTT broker（docs/protocol.md §4）
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
# MQTT_USERNAME= / MQTT_PASSWORD=（本地开发无鉴权，公网前必须开）

# HTTP 调试口
HTTP_HOST=127.0.0.1
HTTP_PORT=8000

# 行为参数
REC_FLUSH_TIMEOUT=2.0   # rec_stop 后等音频帧到齐的静默窗口（秒）
RECORDING_ARCHIVE_DIR=data/recordings  # 录音存档目录（原始 Opus .ogg，可回听定责；空 = 关闭）
FRAME_TIMEOUT=5.0       # 帧重组超时（秒，protocol.md §2）
# FFMPEG_BIN=/opt/homebrew/bin/ffmpeg  # 默认自动探测
