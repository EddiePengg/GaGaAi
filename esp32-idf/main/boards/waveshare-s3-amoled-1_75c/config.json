{
  "board": "waveshare-s3-amoled-1_75c",
  "target": "esp32s3",
  "builds": [
    {
      "name": "waveshare-s3-amoled-1_75c",
      "board_flag": "GAGA_BOARD_WAVESHARE_1_75C",
      "pio_board": "esp32-s3-devkitc-1",
      "flash_size": "32MB",
      "app_max_size": 8388608,
      "partitions": "partitions.csv",
      "sdkconfig_append": [
        "# ---- Flash / 分区（32MB esptool 实测，docs/hardware.md）----",
        "CONFIG_ESPTOOLPY_FLASHMODE_QIO=y",
        "CONFIG_ESPTOOLPY_FLASHFREQ_80M=y",
        "CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y",
        "CONFIG_PARTITION_TABLE_CUSTOM=y",
        "CONFIG_PARTITION_TABLE_CUSTOM_FILENAME=\"partitions.csv\"",
        "# ---- PSRAM：ESP32-S3R8 叠封 8MB octal PSRAM（= arduino-esp32 板定义 memory_type=qio_opi 的 opi 侧）----",
        "CONFIG_SPIRAM=y",
        "CONFIG_SPIRAM_MODE_OCT=y",
        "CONFIG_SPIRAM_SPEED_80M=y",
        "CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y",
        "CONFIG_SPIRAM_RODATA=y",
        "CONFIG_SPIRAM_XIP_FROM_PSRAM=y",
        "# 内部 RAM 瘦身：>16KB malloc 自动落 PSRAM；ALWAYSINTERNAL=64 只留极小分配在内部",
        "#（策略注释与踩坑史在 sdkconfig.base 的 PSRAM 段，真机 2026-09-23~09-27 实测）",
        "CONFIG_SPIRAM_USE_MALLOC=y",
        "CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=64",
        "CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y",
        "CONFIG_ESP32S3_DATA_CACHE_64KB=y",
        "CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y",
        "# DMA 预留池 16K（刷屏反弹 + I2S DMA 十倍余量；误写 32768 偷内部堆 16K 的实锤在 base 注释）",
        "CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=16384",
        "# WiFi/lwIP 内存落 PSRAM（家模式瘦身的前提；base 的 NimBLE 外挂 PSRAM 同理）",
        "CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y",
        "# ---- CPU ----",
        "CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y"
      ]
    }
  ]
}
