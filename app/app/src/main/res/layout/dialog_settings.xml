<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="10dp"
    android:paddingEnd="22dp"
    android:paddingBottom="6dp">

    <!-- ============ 服务器（MQTT）配置（2026-09-27 从主屏迁入） ============ -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="📡 服务器（MQTT）"
        android:textColor="@color/duck_yellow_dark"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/etBrokerHost"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1.5"
            android:background="@drawable/bg_input"
            android:hint="Server host"
            android:inputType="textUri"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:singleLine="true"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etBrokerPort"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input"
            android:hint="Port"
            android:inputType="number"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:singleLine="true"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnSaveBroker"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_btn_start"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:stateListAnimator="@null"
            android:text="💾 保存"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/etMqttUser"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input"
            android:hint="MQTT 用户名（可选）"
            android:inputType="text"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:singleLine="true"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etMqttPass"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input"
            android:hint="MQTT 密码（可选）"
            android:inputType="textPassword"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:singleLine="true"
            android:textSize="14sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="4dp"
        android:background="@color/card_stroke" />

    <!-- ============ 嘎嘎配网（家模式，ADR-065）============ -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="🦆 嘎嘎配网（家模式）"
        android:textColor="@color/duck_yellow_dark"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/etWifiSsid"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input"
            android:hint="WiFi 名称（可从列表选）"
            android:inputType="text"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:singleLine="true"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnPickWifi"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_btn_start"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:stateListAnimator="@null"
            android:text="📶 列表"
            android:textAllCaps="false"
            android:textSize="13sp" />
    </LinearLayout>

    <EditText
        android:id="@+id/etWifiPass"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_input"
        android:hint="WiFi 密码"
        android:inputType="textPassword"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:singleLine="true"
        android:textSize="14sp" />

    <Button
        android:id="@+id/btnSendWifi"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_btn_start"
        android:stateListAnimator="@null"
        android:text="📡 下发到嘎嘎"
        android:textAllCaps="false"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="WiFi 凭证 + 上面的服务器配置（含 MQTT 账号）一起存进嘎嘎。蓝牙断开 60 秒后它自动切换家模式直连。"
        android:textColor="@color/ink_soft"
        android:textSize="12sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="4dp"
        android:background="@color/card_stroke" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Show terminal log"
                android:textColor="@color/ink"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Raw frames &amp; events, for debugging"
                android:textColor="@color/ink_soft"
                android:textSize="12sp" />
        </LinearLayout>

        <Switch
            android:id="@+id/swTerminal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="4dp"
        android:background="@color/card_stroke" />

    <!-- 设备名（ADR-064）：群里署名用。名字经 BLE set_name 信令存进设备 NVS，
         App 只是设置入口（哑管道纪律不破）——所以这里叫"Set"而不存本地 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="🦆 Device name（群里署名）"
        android:textColor="@color/duck_yellow_dark"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/etDevName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="e.g. 胸前嘎嘎"
            android:inputType="text"
            android:maxLines="1"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnSendName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:minWidth="72dp"
            android:text="Set"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="发到群里的消息用这个名字署名。名字存在设备上（需蓝牙已连接），下一条消息生效。"
        android:textColor="@color/ink_soft"
        android:textSize="12sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="4dp"
        android:background="@color/card_stroke" />

    <!-- 保活入口组（ADR-024）：ColorOS 上"耗电管理→完全允许后台行为"与
         "自启动"是两套独立管控，缺一都可能被杀或无法拉活——所以这里
         两个直达入口 + 文案提醒并列，而不只是跳一个应用详情页 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Keep alive — both required"
        android:textColor="@color/ink"
        android:textSize="16sp" />

    <LinearLayout
        android:id="@+id/rowBatteryWhitelist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="?android:attr/selectableItemBackground"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔋 Battery whitelist"
            android:textColor="@color/duck_yellow_dark"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvBatteryState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Off — tap to allow"
            android:textColor="@color/ink_soft"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rowAutoStart"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/selectableItemBackground"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🚀 Auto-start (自启动)"
            android:textColor="@color/duck_yellow_dark"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Allow gaga ai to launch itself — no status API, check it manually"
            android:textColor="@color/ink_soft"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@color/card_stroke"
        android:padding="10dp"
        android:text="⚠ 两处都要开启，缺一不可：\n① 耗电管理 → 完全允许后台行为\n② 自启动管理 → 允许 gaga ai\n只开一个，ColorOS 照样杀后台或拦住自愈拉活。"
        android:textColor="@color/ink_soft"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tvSystemSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/selectableItemBackground"
        android:padding="10dp"
        android:text="🛠 All app system settings"
        android:textColor="@color/ink_soft"
        android:textSize="13sp" />
</LinearLayout>
</ScrollView>
